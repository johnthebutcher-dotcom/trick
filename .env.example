# Copy to .env (git-ignored). Only VITE_-prefixed values reach the browser.
#
# Supabase project URL and the anon/publishable key. These are safe in the client:
# every table is protected by Row Level Security, and anything secret runs in
# Edge Functions. Find both under Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shown in the UI and the PWA manifest fallback.
VITE_APP_NAME=App Starter

# browser (default) or hash. Hash is only for static previews without SPA rewrites.
VITE_ROUTER=browser

# NEVER put these in this file or anywhere in the repo:
#   - the Supabase service_role / secret key
#   - AI provider keys (OpenAI, Anthropic, Gemini, OpenRouter, ...)
#   - database connection strings
# They live only in Supabase Edge Function secrets:
#   supabase secrets set AI_API_KEY=... AI_MODEL=... AI_BASE_URL=...
# See docs/recipes/photo-to-structured-data.md.
